  "sources": {
    "corpus_and_queries": {
      "repository_template": "BeIR/{dataset}",
      "corpus_split": "corpus",
      "queries_split": "queries",
      "revision_source": "local Hugging Face refs/snapshot recovered from the original machine"
    },
    "qrels": {
      "repository_template": "BeIR/{dataset}-qrels",
      "split": "test",
      "revision_source": "local Hugging Face refs/snapshot recovered from the original machine"
    },
    "model": {
      "repository": "lightonai/GTE-ModernColBERT-v1",
      "revision": "cbbe53366e564450558f5e639dd499171f127538",
      "trust_remote_code": false
    },
    "tokenizer": {
      "repository": "lightonai/GTE-ModernColBERT-v1",
      "revision": "cbbe53366e564450558f5e639dd499171f127538",
      "use_fast": true
    }
  },
  "text": {
    "document_fields": ["text"],
    "include_title": false,
    "query_field": "text",
    "ordering": "source_row_order"
  },
  "encoding": {
    "batch_size_documents": 64,
    "batch_size_mechanism_queries": 64,
    "batch_size_quality_queries": 32,
    "device": "cpu",
    "dimension": 128,
    "document_length": 300,
    "query_length": 48,
    "dtype": "float32",
    "precision": "float32",
    "normalize_embeddings": true,
    "is_query_documents": false,
    "is_query_queries": true,
    "query_prefix": "[Q] ",
    "document_prefix": "[D] ",
    "do_query_expansion": false,
    "attend_to_expansion_tokens": false,
    "truncation": true,
    "truncation_strategy": "longest_first",
    "padding_argument": false,
    "effective_tokenizer_padding": "batch_longest",
    "padding_tokens_retained": false,
    "document_skiplist": "ascii_punctuation",
    "query_skiplist": "none",
    "special_tokens": {
      "cls": "[CLS]",
      "sep": "[SEP]",
      "mask_and_pad": "[MASK]",
      "prefix_position": "after_cls"
    },
    "pool_factor": 1,
    "protected_tokens": 1,
    "output_value": "token_embeddings",
    "convert_to_numpy": true
  },
  "software": {
    "final_lockfile": "uv.lock",
    "pylate": "1.6.0",
    "legacy_callsite": "archive/preliminaries/02_bond_variance/bond_variance_analysis.py",
    "legacy_exact_package_versions": "unavailable",
    "legacy_resolution": "do not infer equivalence; apply the bitwise decision gate"
  },
  "workloads": {
    "mechanism": {
      "selection": "seed42_without_replacement_sorted_source_indices",
      "query_count": 50,
      "workload_id_template": "beir-{dataset}-mechanism-seed42-n50-v1"
    },
    "quality": {
      "selection": "qrels_test_ids_in_queries_source_order",
      "workload_id_template": "beir-{dataset}-qrels-test-v1"
    }
  },
  "indexes": {
    "faiss": {
      "metric": "inner_product",
      "seed": 42,
      "n_lists_policy": "power_of_two_nearest_4sqrt_total_tokens"
    },
    "plaid": {
      "implementation": "pylate-1.6.0-public-api",
      "seed": 42,
      "n_ivf_probe": 8
    }
  },
  "outputs": {
    "embedding_format": "npz-flat-token-major",
    "id_sidecar_format": "json-ordered-ids",
    "qrels_format": "beir-tsv",
    "manifest_format": "bondmaxsim.data-manifest-1.0.0",
    "atomic": true,
    "resumable_unit": "dataset"
  }
}
